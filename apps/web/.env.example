# Proveedor de IA por defecto: openai, gemini o mock (para desarrollo local sin conexión)
AI_PROVIDER=mock

# Claves de APIs para generación con Inteligencia Artificial (Notebooks, Speaking Feedback, Importer)
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Configuración de Base de Datos y Autenticación Supabase (Opcional, con fallback a localStorage offline)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
